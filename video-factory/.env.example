# このファイルは「見本」です。GitHub に保存されます。
# 実際に使うときは、このファイルをコピーして「.env」という名前にし、値を書き込みます。
# .env は GitHub に保存されません（.gitignore で除外済み）。新しいPCでは手で作り直します。

# VOICEVOX エンジンの接続先（VOICEVOX アプリを起動すると使えます）
VOICEVOX_URL=http://127.0.0.1:50021

# ナレーションの声（VOICEVOX の話者ID。例: 3 = ずんだもん ノーマル）
VOICEVOX_SPEAKER=3

# 将来使う予定のキー（今は空のままでOK）
YOUTUBE_API_KEY=
